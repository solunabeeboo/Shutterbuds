---
// Hand-built vector banner: hill + forest + critters, the buds on top,
// and the crate with the mystery creature. Each layer is its own <g>,
// so any piece can be swapped for drawn art later.
const ink = '#22190f';
---

<svg
  class="sb-scene"
  viewBox="0 0 1600 600"
  preserveAspectRatio="xMidYMax slice"
  role="img"
  aria-label="The buds standing on a hill above a crate holding a mystery creature, with forest and critters all around"
>
  <defs>
    <linearGradient id="sc-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#38a9e0"></stop>
      <stop offset="1" stop-color="#bfe7f5"></stop>
    </linearGradient>

    <!-- pine tree -->
    <symbol id="sc-pine" viewBox="0 0 60 120" overflow="visible">
      <rect x="25" y="92" width="10" height="26" fill="#6b4422" stroke={ink} stroke-width="3"></rect>
      <path
        d="M30 3 L49 38 H40 L55 66 H44 L59 96 H1 L16 66 H5 L20 38 H11 Z"
        fill="currentColor"
        stroke={ink}
        stroke-width="3"
        stroke-linejoin="round"></path>
    </symbol>

    <!-- bush with peeking eyes -->
    <symbol id="sc-bush" viewBox="0 0 120 70" overflow="visible">
      <path
        d="M6 68 C-4 46 14 30 30 36 C32 14 60 8 70 26 C82 12 110 20 104 42 C122 46 118 68 104 68 Z"
        fill="#3f8a2e"
        stroke={ink}
        stroke-width="3.5"
        stroke-linejoin="round"></path>
    </symbol>

    <!-- bud (arm poses drawn per bud) -->
    <symbol id="sc-bud" viewBox="0 0 100 180" overflow="visible">
      <rect x="30" y="118" width="17" height="56" rx="7" fill="#2c3150" stroke={ink} stroke-width="3.5"></rect>
      <rect x="53" y="118" width="17" height="56" rx="7" fill="#2c3150" stroke={ink} stroke-width="3.5"></rect>
      <rect x="18" y="66" width="64" height="54" rx="14" fill="#6b4a2f" stroke={ink} stroke-width="3.5"></rect>
      <rect x="26" y="64" width="48" height="62" rx="16" fill="#f3eee6" stroke={ink} stroke-width="3.5"></rect>
      <path d="M36 66 L40 124 M64 66 L60 124" stroke="#6b4a2f" stroke-width="6"></path>
      <circle cx="50" cy="38" r="30" fill="currentColor" stroke={ink} stroke-width="3.5"></circle>
      <circle cx="41" cy="35" r="3.4" fill={ink}></circle>
      <circle cx="59" cy="35" r="3.4" fill={ink}></circle>
      <path d="M39 46 Q50 55 61 46" fill="none" stroke={ink} stroke-width="3" stroke-linecap="round"></path>
    </symbol>

    <!-- mystery creature silhouette -->
    <symbol id="sc-creature" viewBox="0 0 120 90" overflow="visible">
      <g fill="#15160f">
        <path d="M26 30 L18 2 L40 22 Z"></path>
        <path d="M70 22 L92 2 L86 32 Z"></path>
        <ellipse cx="56" cy="50" rx="44" ry="32"></ellipse>
        <path d="M96 52 C112 44 120 58 112 66 C106 60 100 62 96 62 Z"></path>
        <rect x="24" y="70" width="16" height="18" rx="6"></rect>
        <rect x="70" y="70" width="16" height="18" rx="6"></rect>
      </g>
      <ellipse cx="42" cy="44" rx="6" ry="7" fill="#f6f1c8"></ellipse>
      <ellipse cx="66" cy="44" rx="6" ry="7" fill="#f6f1c8"></ellipse>
      <circle cx="43" cy="46" r="2.6" fill="#15160f"></circle>
      <circle cx="67" cy="46" r="2.6" fill="#15160f"></circle>
    </symbol>
  </defs>

  <!-- sky -->
  <rect width="1600" height="600" fill="url(#sc-sky)"></rect>
  <g fill="#fff" stroke={ink} stroke-width="3" opacity="0.95">
    <path d="M150 120 c0-26 40-32 52-12 c10-22 52-18 54 8 c22-2 30 26 8 30 H160 c-20 0-24-24-10-26Z"></path>
    <path d="M1250 90 c0-22 34-28 46-10 c10-20 46-16 48 8 c20-2 26 24 6 26 H1260 c-18 0-22-22-10-24Z"></path>
    <path d="M560 70 c0-16 26-20 34-6 c8-14 34-10 34 6 c14 0 18 18 4 20 H568 c-14 0-16-18-8-20Z"></path>
  </g>
  <!-- birds -->
  <g fill="none" stroke={ink} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M420 150 q12-12 22 0 q10-12 22 0"></path>
    <path d="M480 120 q9-9 17 0 q8-9 17 0"></path>
    <path d="M1100 160 q12-12 22 0 q10-12 22 0"></path>
  </g>

  <!-- far mountains -->
  <path
    d="M0 400 L120 300 L220 360 L360 250 L520 370 L640 320 L800 380 L960 310 L1080 360 L1240 250 L1380 350 L1480 290 L1600 360 V600 H0Z"
    fill="#7fa9b8"
    stroke={ink}
    stroke-width="3"
    stroke-linejoin="round"></path>

  <!-- rock spires -->
  <g fill="#d9623a" stroke={ink} stroke-width="3.5" stroke-linejoin="round">
    <path d="M70 470 C60 380 80 300 110 280 C140 300 150 380 140 470 Z"></path>
    <path d="M140 470 C140 400 160 350 185 340 C210 360 214 420 210 470 Z"></path>
    <path d="M1400 470 C1395 390 1420 320 1450 305 C1480 325 1490 400 1480 470 Z"></path>
    <path d="M1480 470 C1480 420 1500 380 1520 372 C1542 388 1546 430 1544 470 Z"></path>
  </g>
  <g stroke="#a8432a" stroke-width="3" fill="none" stroke-linecap="round">
    <path d="M100 320 v40 M120 360 v50 M1440 340 v40 M1462 380 v50"></path>
  </g>

  <!-- back forest -->
  <g color="#2f6b3a">
    <use href="#sc-pine" x="200" y="330" width="50" height="100"></use>
    <use href="#sc-pine" x="240" y="350" width="44" height="88"></use>
    <use href="#sc-pine" x="330" y="340" width="50" height="100"></use>
    <use href="#sc-pine" x="440" y="360" width="44" height="88"></use>
    <use href="#sc-pine" x="1080" y="350" width="46" height="92"></use>
    <use href="#sc-pine" x="1180" y="330" width="52" height="104"></use>
    <use href="#sc-pine" x="1290" y="345" width="46" height="92"></use>
    <use href="#sc-pine" x="1340" y="360" width="40" height="80"></use>
  </g>

  <!-- side hills -->
  <path
    d="M-20 600 V470 C120 420 300 420 470 470 C540 492 560 560 560 600 Z"
    fill="#4f9a33"
    stroke={ink}
    stroke-width="3.5"></path>
  <path
    d="M1620 600 V470 C1480 420 1300 420 1130 470 C1060 492 1040 560 1040 600 Z"
    fill="#4f9a33"
    stroke={ink}
    stroke-width="3.5"></path>

  <!-- critters on the side hills -->
  <!-- turtle with a flower on its shell -->
  <g transform="translate(330 452)">
    <ellipse cx="-34" cy="18" rx="14" ry="11" fill="#9fd33a" stroke={ink} stroke-width="3"></ellipse>
    <circle cx="-38" cy="15" r="2.4" fill={ink}></circle>
    <rect x="-18" y="22" width="12" height="16" rx="5" fill="#9fd33a" stroke={ink} stroke-width="3"></rect>
    <rect x="12" y="22" width="12" height="16" rx="5" fill="#9fd33a" stroke={ink} stroke-width="3"></rect>
    <path d="M-26 28 C-26 -6 34 -6 34 28 Z" fill="#5b8a3a" stroke={ink} stroke-width="3.5"></path>
    <g fill="#fff" stroke={ink} stroke-width="2">
      <circle cx="4" cy="2" r="5"></circle><circle cx="12" cy="7" r="5"></circle><circle cx="-4" cy="7" r="5"></circle>
      <circle cx="0" cy="15" r="5"></circle><circle cx="10" cy="15" r="5"></circle>
    </g>
    <circle cx="4" cy="10" r="4" fill="#f2b632" stroke={ink} stroke-width="2"></circle>
  </g>
  <!-- bunny -->
  <g transform="translate(1290 456)">
    <ellipse cx="-6" cy="-26" rx="6" ry="18" fill="#f0e6d6" stroke={ink} stroke-width="3" transform="rotate(-12 -6 -26)"
    ></ellipse>
    <ellipse cx="8" cy="-26" rx="6" ry="18" fill="#f0e6d6" stroke={ink} stroke-width="3" transform="rotate(14 8 -26)"
    ></ellipse>
    <ellipse cx="4" cy="16" rx="24" ry="18" fill="#f0e6d6" stroke={ink} stroke-width="3"></ellipse>
    <circle cx="2" cy="-2" r="16" fill="#f0e6d6" stroke={ink} stroke-width="3"></circle>
    <circle cx="-4" cy="-4" r="2.4" fill={ink}></circle><circle cx="8" cy="-4" r="2.4" fill={ink}></circle>
    <circle cx="2" cy="3" r="2" fill="#e58a9a"></circle>
  </g>
  <!-- snail -->
  <g transform="translate(470 520)">
    <path d="M-30 18 H24 C30 18 32 8 26 4 L22 2" fill="#e8c27a" stroke={ink} stroke-width="3" stroke-linejoin="round"
    ></path>
    <path d="M26 4 L30 -12 M22 4 L20 -12" stroke={ink} stroke-width="3" stroke-linecap="round"></path>
    <circle cx="-4" cy="2" r="16" fill="#c0693a" stroke={ink} stroke-width="3"></circle>
    <path d="M-4 2 m-8 0 a8 8 0 1 1 8 8 a4 4 0 1 1 -4 -4" fill="none" stroke={ink} stroke-width="2.5"></path>
  </g>

  <!-- center hill -->
  <path d="M330 600 C420 470 600 388 800 384 C1000 388 1180 470 1270 600 Z" fill="#6cbf3f" stroke={ink} stroke-width="4"
  ></path>
  <path d="M470 520 C580 440 680 412 800 410" fill="none" stroke="#8ad45a" stroke-width="10" stroke-linecap="round"
  ></path>
  <!-- grass tufts -->
  <g fill="none" stroke={ink} stroke-width="3" stroke-linecap="round">
    <path d="M560 470 l4-12 l4 12 l4-10 l4 10"></path>
    <path d="M1010 455 l4-12 l4 12 l4-10 l4 10"></path>
    <path d="M640 560 l4-12 l4 12 l4-10 l4 10"></path>
    <path d="M940 560 l4-12 l4 12 l4-10 l4 10"></path>
  </g>

  <!-- mushrooms -->
  <g stroke={ink} stroke-width="3">
    <rect x="967" y="482" width="12" height="26" rx="4" fill="#f3e9d8"></rect>
    <path d="M950 486 C950 462 996 462 996 486 Z" fill="#d8442f"></path>
    <circle cx="962" cy="476" r="4" fill="#fff" stroke-width="2"></circle>
    <circle cx="980" cy="472" r="4" fill="#fff" stroke-width="2"></circle>
    <rect x="618" y="494" width="10" height="20" rx="4" fill="#f3e9d8"></rect>
    <path d="M604 498 C604 478 642 478 642 498 Z" fill="#d8442f"></path>
    <circle cx="620" cy="489" r="3.4" fill="#fff" stroke-width="2"></circle>
  </g>

  <!-- the buds on top of the hill -->
  <!-- left bud, waving -->
  <g transform="translate(672 222)" color="#f07a3c">
    <path d="M20 84 L-6 42" stroke={ink} stroke-width="16" stroke-linecap="round"></path>
    <path d="M20 84 L-6 42" stroke="#f07a3c" stroke-width="10" stroke-linecap="round"></path>
    <use href="#sc-bud" width="100" height="180"></use>
    <path d="M80 84 L92 118" stroke={ink} stroke-width="16" stroke-linecap="round"></path>
    <path d="M80 84 L92 118" stroke="#f07a3c" stroke-width="10" stroke-linecap="round"></path>
  </g>
  <!-- right bud, waving -->
  <g transform="translate(828 222)" color="#e86bb8">
    <path d="M80 84 L106 42" stroke={ink} stroke-width="16" stroke-linecap="round"></path>
    <path d="M80 84 L106 42" stroke="#e86bb8" stroke-width="10" stroke-linecap="round"></path>
    <use href="#sc-bud" width="100" height="180"></use>
    <path d="M20 84 L8 118" stroke={ink} stroke-width="16" stroke-linecap="round"></path>
    <path d="M20 84 L8 118" stroke="#e86bb8" stroke-width="10" stroke-linecap="round"></path>
  </g>
  <!-- center bud, holding the camera up -->
  <g transform="translate(750 206)" color="#c9e04b">
    <use href="#sc-bud" width="100" height="180"></use>
    <path d="M24 86 L38 106 M76 86 L62 106" stroke={ink} stroke-width="16" stroke-linecap="round"></path>
    <path d="M24 86 L38 106 M76 86 L62 106" stroke="#c9e04b" stroke-width="10" stroke-linecap="round"></path>
    <rect x="28" y="88" width="44" height="30" rx="5" fill="#4a4370" stroke={ink} stroke-width="3.5"></rect>
    <rect x="34" y="83" width="12" height="7" rx="2" fill="#4a4370" stroke={ink} stroke-width="3"></rect>
    <circle cx="52" cy="103" r="10" fill="#a9b3d8" stroke={ink} stroke-width="3.5"></circle>
    <circle cx="52" cy="103" r="4" fill={ink}></circle>
  </g>

  <!-- crate with the mystery creature -->
  <g transform="translate(722 420)">
    <rect x="0" y="0" width="156" height="118" rx="5" fill="#e3d3a6" stroke={ink} stroke-width="4"></rect>
    <use href="#sc-creature" x="22" y="20" width="116" height="88"></use>
    <g fill="#a06a3c" stroke={ink} stroke-width="3.5">
      <rect x="0" y="0" width="156" height="20" rx="4"></rect>
      <rect x="0" y="98" width="156" height="20" rx="4"></rect>
      <rect x="6" y="18" width="14" height="82"></rect>
      <rect x="72" y="18" width="12" height="82"></rect>
      <rect x="136" y="18" width="14" height="82"></rect>
    </g>
    <g fill="#c58a52">
      <rect x="6" y="5" width="144" height="4" rx="2"></rect>
      <rect x="6" y="103" width="144" height="4" rx="2"></rect>
    </g>
    <!-- "?" tag -->
    <g transform="translate(130 -16) rotate(12)">
      <path d="M0 0 L-6 -14" stroke={ink} stroke-width="3"></path>
      <rect x="-14" y="0" width="34" height="38" rx="5" fill="#f6eedd" stroke={ink} stroke-width="3.5"></rect>
      <text
        x="3"
        y="30"
        text-anchor="middle"
        font-family="Fredoka, sans-serif"
        font-weight="700"
        font-size="30"
        fill={ink}>?</text
      >
    </g>
  </g>

  <!-- front forest framing the edges -->
  <g color="#245a2c">
    <use href="#sc-pine" x="-40" y="300" width="130" height="260"></use>
    <use href="#sc-pine" x="60" y="380" width="100" height="200"></use>
    <use href="#sc-pine" x="1500" y="290" width="130" height="260"></use>
    <use href="#sc-pine" x="1430" y="380" width="100" height="200"></use>
  </g>
  <path
    d="M0 600 V560 C200 548 400 552 560 572 C700 590 900 590 1040 572 C1200 552 1400 548 1600 560 V600 Z"
    fill="#3f8a2e"
    stroke={ink}
    stroke-width="3.5"></path>
  <g transform="translate(0 -14)">
    <!-- front bushes with peeking critters -->
    <use href="#sc-bush" x="520" y="540" width="130" height="76"></use>
    <g fill="#fff" stroke={ink} stroke-width="2">
      <circle cx="574" cy="568" r="6"></circle><circle cx="590" cy="568" r="6"></circle>
    </g>
    <g fill={ink}><circle cx="576" cy="569" r="2.6"></circle><circle cx="592" cy="569" r="2.6"></circle></g>
    <use href="#sc-bush" x="960" y="544" width="120" height="70"></use>
    <g fill="#fff" stroke={ink} stroke-width="2">
      <circle cx="1018" cy="572" r="5"></circle><circle cx="1032" cy="572" r="5"></circle>
    </g>
    <g fill={ink}><circle cx="1016" cy="573" r="2.2"></circle><circle cx="1030" cy="573" r="2.2"></circle></g>
  </g>
</svg>

<style>
  .sb-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
