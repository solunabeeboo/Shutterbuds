---
import Layout from '~/layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import HeroScene from '~/components/shutterbuds/HeroScene.astro';
import logo from '~/assets/images/shutterbuds/logo.png';

// Update this number to move the progress bar.
const POSTS = 0;
const GOAL = 1000;
const pct = Math.min(100, (POSTS / GOAL) * 100);

// Nav items and social icons are placeholders: they render but go nowhere.
const navItems = ['the game', 'snaps', 'buds'];
const socials = [
  { name: 'Instagram', icon: 'tabler:brand-instagram', cls: 'sb-ig' },
  { name: 'TikTok', icon: 'tabler:brand-tiktok', cls: 'sb-tt' },
  { name: 'YouTube', icon: 'tabler:brand-youtube-filled', cls: 'sb-yt' },
];

const jobSteps = [
  'Grab your buds and find a Hufu.',
  'Wrangle it. Ride it. Get the shot (or the clip).',
  'Post it with #Shutterbuds and #RaceTo1000',
  'Hit 1000 posts in 2 weeks and a new SPECIAL creature joins the game!',
];

// DRAFT rules. Fill in every [bracket] and have someone qualified review before launch.
const rules = [
  {
    title: 'No purchase necessary',
    body: 'Entry is free. Buying anything will not help you win. shutterbuds is free to play, so all you need is the game.',
  },
  {
    title: 'Who can enter',
    body: 'Open to players who are [minimum age] or older and live in [eligible countries/regions]. Employees of [studio name] and their households can post for fun but cannot win the team prize.',
  },
  {
    title: 'Entry period',
    body: 'The Race to 1000 runs for 14 days, from [start date, time, time zone] to [end date, time, time zone]. Posts made outside this window do not count.',
  },
  {
    title: 'How to enter',
    body: 'Post an original photo or video taken in shutterbuds that shows a player wrangling or riding a Hufu creature. Post it publicly on Instagram, TikTok or YouTube with #Shutterbuds and #RaceTo1000. Your account must be public so we can count it.',
  },
  {
    title: 'The community goal',
    body: 'If at least 1000 eligible posts go up during the entry period, [studio name] will add a new special creature to shutterbuds for all players. Release date: [TBD].',
  },
  {
    title: 'Top team prize',
    body: 'The [number] teams or contributors with the most eligible posts each get [number] free crochet kits, shipped at no cost to [eligible regions]. Winners are contacted by DM within [X] days of the end date and must reply within [X] days or a new winner is picked.',
  },
  {
    title: 'What counts',
    body: 'Entries must be your own and made in shutterbuds. No hate, harassment, nudity or anything you would not show your grandma. Reposts, duplicates, bots and bought engagement do not count. We can disqualify entries that break these rules.',
  },
  {
    title: 'Using your posts',
    body: 'By posting with the hashtags you let [studio name] reshare and feature your post, with credit to you, on our channels and in marketing for shutterbuds.',
  },
  {
    title: 'The fine print',
    body: 'This giveaway is not sponsored, endorsed or run by Instagram, TikTok or YouTube. Void where prohibited. Sponsor: [studio name, address]. Questions: [contact email].',
  },
];

const metadata = { title: 'Race to 1000!' };
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@500;700;800&family=Patrick+Hand&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <!-- Leaf shape, same idea as the in-game cursor -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="sb-leaf" viewBox="0 0 32 32">
      <path
        d="M16 2C9 7 5 13 6 20c.6 4 3.6 7 7 8l3 3 1.5-3.4C23 26 27 21 26.5 14 26 9 22 5 16 2Z"
        fill="#9fd33a"
        stroke="#2a3a14"
        stroke-width="2.2"
        stroke-linejoin="round"></path>
      <path d="M16.5 27C16 19 15.5 12 16 5" fill="none" stroke="#2a3a14" stroke-width="1.8" stroke-linecap="round"
      ></path>
    </symbol>
  </svg>

  <div class="sb">
    <!-- Header -->
    <header class="sb-header">
      <div class="sb-wrap sb-header-inner">
        <span class="sb-logo">
          <Image src={logo} alt="shutterbuds" width={400} class="sb-logo-img" loading="eager" />
        </span>
        <nav aria-label="Main">
          <ul class="sb-nav">
            {
              navItems.map((item) => (
                <li>
                  <button type="button" class="sb-nav-stub" aria-disabled="true">
                    {item}
                  </button>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <!-- Post counter -->
    <section class="sb-progress" aria-label="Posts so far">
      <p class="sb-count">
        <span class="sb-count-num">{POSTS}</span> / {GOAL}
        <span class="sb-count-unit">captures</span>
      </p>
      <div class="sb-strip">
        <div
          class="sb-bar"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax={GOAL}
          aria-valuenow={POSTS}
          aria-label="Captures posted"
        >
          <div class="sb-bar-fill" style={`width:${pct}%`}></div>
        </div>
      </div>
    </section>

    <!-- Banner -->
    <section class="sb-hero">
      <HeroScene />
      <h1 class="sb-hero-title">Race to 1000!</h1>
    </section>

    <!-- Campaign -->
    <main class="sb-wrap sb-wide sb-campaign">
      <div class="sb-campaign-head">
        <h2 class="sb-h2">Giveaway Campaign</h2>
        <div class="sb-underline" aria-hidden="true"></div>
      </div>

      <div class="sb-grid">
        <!-- Unlock prize: creature in a cage -->
        <aside class="sb-side">
          <Icon name="tabler:star-filled" class="sb-side-icon sb-star" />
          <svg class="sb-cage" viewBox="0 0 170 210" aria-hidden="true">
            <circle cx="85" cy="14" r="10" fill="none" stroke="#22190f" stroke-width="5"></circle>
            <path d="M18 70 C18 20 152 20 152 70" fill="#8a6446" stroke="#22190f" stroke-width="5"></path>
            <rect x="12" y="64" width="146" height="14" rx="5" fill="#8a6446" stroke="#22190f" stroke-width="5"></rect>
            <rect x="20" y="78" width="130" height="104" fill="#e6f2d8"></rect>
            <g transform="translate(28 96)">
              <g fill="#15160f">
                <path d="M26 30 L18 2 L40 22 Z"></path>
                <path d="M70 22 L92 2 L86 32 Z"></path>
                <ellipse cx="56" cy="50" rx="44" ry="32"></ellipse>
                <path d="M96 52 C112 44 120 58 112 66 C106 60 100 62 96 62 Z"></path>
                <rect x="24" y="70" width="16" height="16" rx="6"></rect>
                <rect x="70" y="70" width="16" height="16" rx="6"></rect>
              </g>
              <ellipse cx="42" cy="44" rx="6" ry="7" fill="#f6f1c8"></ellipse>
              <ellipse cx="66" cy="44" rx="6" ry="7" fill="#f6f1c8"></ellipse>
              <circle cx="43" cy="46" r="2.6" fill="#15160f"></circle>
              <circle cx="67" cy="46" r="2.6" fill="#15160f"></circle>
            </g>
            <g stroke="#22190f" stroke-width="5" stroke-linecap="round">
              <path d="M22 78 V182 M48 78 V182 M74 78 V182 M100 78 V182 M126 78 V182 M150 78 V182"></path>
            </g>
            <rect x="8" y="180" width="154" height="20" rx="6" fill="#8a6446" stroke="#22190f" stroke-width="5"></rect>
            <g transform="translate(132 98) rotate(10)">
              <rect x="-4" y="0" width="36" height="40" rx="6" fill="#f6eedd" stroke="#22190f" stroke-width="4"></rect>
              <text
                x="14"
                y="32"
                text-anchor="middle"
                font-family="Fredoka, sans-serif"
                font-weight="700"
                font-size="32"
                fill="#22190f">?</text
              >
            </g>
          </svg>
          <h3 class="sb-side-title">Release</h3>
          <p class="sb-side-sub">a new creature</p>
          <p class="sb-side-note">hit 1000 to open the cage</p>
        </aside>

        <!-- Job notice + rules -->
        <article class="sb-card">
          <div class="sb-tape" aria-hidden="true"></div>

          <div class="sb-card-top">
            <div class="sb-card-text">
              <p class="sb-card-kicker">
                <svg class="sb-leaf" aria-hidden="true"><use href="#sb-leaf"></use></svg>
                new job posted!
              </p>
              <h3 class="sb-card-title">You are jobless!</h3>
              <p>
                Not anymore. For the next 2 weeks every bud gets the same job: snap photos or clips of your crew
                wranglin' 'n ridin' a Hufu, then post them with <strong>#Shutterbuds</strong>.
              </p>
              <ul class="sb-steps">
                {
                  jobSteps.map((step) => (
                    <li>
                      <svg class="sb-leaf" aria-hidden="true">
                        <use href="#sb-leaf" />
                      </svg>
                      <span>{step}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="sb-card-sign">No purchase needed. Just buds being buds.</p>
            </div>

            <div class="sb-card-media">
              <div class="sb-circles">
                {
                  socials.map((s, i) => (
                    <span class={`sb-circle sb-c${i + 1} ${s.cls}`} role="img" aria-label={s.name}>
                      <Icon name={s.icon} />
                    </span>
                  ))
                }
              </div>
              <p class="sb-hashtags">#RaceTo1000<br />#Shutterbuds</p>
            </div>
          </div>

          <section class="sb-rules" aria-labelledby="sb-rules-title">
            <h3 id="sb-rules-title" class="sb-rules-title">Official rules</h3>
            <ol class="sb-rules-list">
              {
                rules.map((r) => (
                  <li>
                    <strong>{r.title}.</strong> {r.body}
                  </li>
                ))
              }
            </ol>
          </section>
        </article>

        <!-- Team prize: crochet kit -->
        <aside class="sb-side">
          <Icon name="tabler:crown-filled" class="sb-side-icon sb-crown" />
          <div class="sb-slot" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <path d="M18 104 L104 20" stroke="#22190f" stroke-width="11" stroke-linecap="round"></path>
              <path d="M18 104 L104 20" stroke="#d9c7a3" stroke-width="5" stroke-linecap="round"></path>
              <path d="M104 20 l-8 -2" stroke="#22190f" stroke-width="5" stroke-linecap="round"></path>
              <circle cx="56" cy="64" r="36" fill="#e86bb8" stroke="#22190f" stroke-width="5"></circle>
              <g fill="none" stroke="#b3438b" stroke-width="4" stroke-linecap="round">
                <path d="M28 52 C44 42 70 42 88 54"></path>
                <path d="M24 66 C44 56 72 56 92 70"></path>
                <path d="M30 82 C46 72 70 72 86 84"></path>
                <path d="M46 30 C38 50 38 76 48 98"></path>
              </g>
              <path
                d="M84 88 C96 98 100 108 112 108"
                fill="none"
                stroke="#22190f"
                stroke-width="4"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <h3 class="sb-side-title">#1 Team</h3>
          <p class="sb-side-sub">gets free crochet kits</p>
          <p class="sb-side-note">shipped to the top crews, on us</p>
        </aside>
      </div>
    </main>

    <footer class="sb-footer">
      <p>© {new Date().getFullYear()} shutterbuds</p>
    </footer>
  </div>
</Layout>

<style>
  .sb {
    --sb-cream: #f6eedd;
    --sb-paper: #fffcf4;
    --sb-ink: #22190f;
    --sb-brown: #5b3a22;
    --sb-brown-soft: #8a6446;
    --sb-forest: #2e5e2a;
    --sb-leaf: #5fae38;
    --sb-lime: #c9e04b;
    --sb-gold: #f2b632;
    --sb-display: 'Fredoka', 'Nunito', system-ui, sans-serif;
    --sb-body: 'Nunito', system-ui, sans-serif;
    --sb-hand: 'Patrick Hand', 'Comic Sans MS', cursive;
    --sb-wobble: 14px 6px 16px 5px / 5px 16px 6px 14px;

    background: var(--sb-paper);
    color: var(--sb-ink);
    font-family: var(--sb-body);
    letter-spacing: normal;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }
  .sb-wrap {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .sb-wide {
    max-width: none;
    padding: 0 16px;
  }
  .sb-leaf {
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }

  /* Header */
  .sb-header {
    border-bottom: 2px solid var(--sb-ink);
  }
  .sb-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .sb-logo-img {
    height: 50px;
    width: auto;
  }
  .sb-nav {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sb-nav-stub {
    font-family: var(--sb-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--sb-brown);
    background: none;
    border: 0;
    border-bottom: 3px solid var(--sb-brown);
    padding: 4px 4px 2px;
    margin: 0 10px;
    cursor: default;
  }

  /* Post counter */
  .sb-progress {
    text-align: center;
    padding: 10px 16px 14px;
    border-bottom: 2px solid var(--sb-ink);
  }
  .sb-count {
    margin: 0;
    font-family: var(--sb-hand);
    font-size: 1.9rem;
    line-height: 1;
  }
  .sb-count-num {
    color: var(--sb-leaf);
  }
  .sb-count-unit {
    font-size: 1.3rem;
    margin-left: 6px;
    color: var(--sb-brown-soft);
  }
  .sb-strip {
    position: relative;
    width: min(100%, 640px);
    margin: 6px auto 0;
    padding: 0 10px;
  }
  .sb-strip::before,
  .sb-strip::after {
    content: '';
    position: absolute;
    top: -5px;
    bottom: -5px;
    width: 10px;
    border: 3px solid var(--sb-ink);
    background: var(--sb-paper);
  }
  .sb-strip::before {
    left: 0;
    border-right: 0;
  }
  .sb-strip::after {
    right: 0;
    border-left: 0;
  }
  .sb-bar {
    height: 18px;
    border: 3px solid var(--sb-ink);
    background-color: #fff;
    background-image: radial-gradient(var(--sb-ink) 1px, transparent 1.6px);
    background-size: 22px 100%;
    background-position: 11px 0;
    overflow: hidden;
  }
  .sb-bar-fill {
    height: 100%;
    background: var(--sb-lime);
  }

  /* Banner */
  .sb-hero {
    position: relative;
    height: clamp(360px, 40vw, 600px);
    overflow: hidden;
    border-bottom: 3px solid var(--sb-ink);
    background: #8fd2ef;
  }
  .sb-hero-title {
    position: absolute;
    top: clamp(14px, 2.6vw, 34px);
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 6.5vw, 5rem);
    line-height: 1;
    color: var(--sb-cream);
    -webkit-text-stroke: 4px var(--sb-brown);
    paint-order: stroke fill;
    text-shadow: 0 5px 0 var(--sb-brown);
    transform: rotate(-2deg);
    z-index: 1;
  }

  /* Campaign */
  .sb-campaign {
    padding-top: 36px;
    padding-bottom: 64px;
    flex: 1;
  }
  .sb-campaign-head {
    text-align: center;
    margin-bottom: 32px;
  }
  .sb-h2 {
    margin: 0;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    color: var(--sb-forest);
  }
  .sb-underline {
    width: min(100%, 460px);
    height: 12px;
    margin: 8px auto 0;
    border: 3px solid var(--sb-ink);
    background: var(--sb-lime);
    border-radius: 2px 6px 3px 5px;
  }
  .sb-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .sb-grid {
      /* side columns fill the gutters, so their content sits centered
         between the screen edge and the card */
      grid-template-columns: minmax(230px, 1fr) minmax(0, 1260px) minmax(230px, 1fr);
      gap: 0;
    }
    .sb-wide {
      padding-left: 0;
      padding-right: 0;
    }
    .sb-side {
      position: sticky;
      top: 24px;
    }
  }

  /* Side columns */
  .sb-side {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sb-side-icon {
    width: 46px;
    height: 46px;
    margin-bottom: 10px;
  }
  .sb-star {
    color: var(--sb-gold);
    filter: drop-shadow(0 2px 0 var(--sb-ink));
    transform: rotate(-10deg);
  }
  .sb-crown {
    color: var(--sb-gold);
    filter: drop-shadow(0 2px 0 var(--sb-ink));
  }
  .sb-side-title {
    margin: 18px 0 0;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    white-space: nowrap;
  }
  .sb-side-sub {
    margin: 4px 0 0;
    font-family: var(--sb-hand);
    font-size: 1.4rem;
    line-height: 1.1;
  }
  .sb-side-note {
    margin: 10px 0 0;
    font-family: var(--sb-hand);
    font-size: 1.05rem;
    color: var(--sb-brown-soft);
  }
  .sb-cage {
    width: 170px;
    height: auto;
    filter: drop-shadow(4px 5px 0 rgba(34, 25, 15, 0.25));
  }

  /* Prize slot, styled like the in-game photo slots */
  .sb-slot {
    width: 160px;
    height: 160px;
    margin-top: 10px;
    padding: 14px;
    background: var(--sb-lime);
    border: 7px solid #fff;
    outline: 3px solid var(--sb-ink);
    border-radius: 6px 12px 5px 10px;
    box-shadow: 6px 6px 0 3px var(--sb-ink);
    transform: rotate(-5deg);
  }
  .sb-slot svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Card */
  .sb-card {
    position: relative;
    background: #fff;
    border: 4px solid var(--sb-ink);
    border-radius: var(--sb-wobble);
    box-shadow: 7px 7px 0 var(--sb-ink);
    padding: 38px clamp(20px, 3vw, 44px) 32px;
  }
  @media (max-width: 999px) {
    .sb-card {
      order: -1;
    }
  }
  .sb-card-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  @media (min-width: 720px) {
    .sb-card-top {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .sb-tape {
    position: absolute;
    top: -16px;
    left: 50%;
    width: 120px;
    height: 30px;
    background: rgba(214, 190, 140, 0.85);
    border: 2px solid rgba(34, 25, 15, 0.35);
    transform: translateX(-50%) rotate(-3deg);
  }
  .sb-card-kicker {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-family: var(--sb-hand);
    font-size: 1.25rem;
    color: var(--sb-forest);
  }
  .sb-card-title {
    margin: 2px 0 10px;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: 2.1rem;
    line-height: 1.1;
  }
  .sb-card-text p {
    line-height: 1.55;
  }
  .sb-card-text > p:not(.sb-card-kicker) {
    margin: 0 0 14px;
    max-width: 62ch;
  }
  .sb-steps {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }
  .sb-steps li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 10px;
    font-weight: 700;
    line-height: 1.4;
  }
  .sb-steps .sb-leaf {
    margin-top: 1px;
  }
  .sb-steps li:nth-child(even) .sb-leaf {
    transform: rotate(18deg);
  }
  .sb-steps li:nth-child(odd) .sb-leaf {
    transform: rotate(-12deg);
  }
  .sb-card-text > p.sb-card-sign {
    margin: 0;
    font-family: var(--sb-hand);
    font-size: 1.35rem;
    color: var(--sb-forest);
    transform: rotate(-1.5deg);
  }
  .sb-card-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .sb-circles {
    position: relative;
    width: 250px;
    height: 236px;
  }
  .sb-circle {
    position: absolute;
    border-radius: 50%;
    border: 5px solid #fff;
    outline: 3px solid var(--sb-ink);
    box-shadow: 4px 4px 0 2px var(--sb-ink);
    display: grid;
    place-items: center;
    color: #fff;
  }
  .sb-circle :global(svg) {
    width: 52%;
    height: 52%;
  }
  .sb-c1 {
    width: 106px;
    height: 106px;
    top: 0;
    right: 36px;
  }
  .sb-c2 {
    width: 124px;
    height: 124px;
    bottom: 4px;
    left: 0;
  }
  .sb-c3 {
    width: 98px;
    height: 98px;
    bottom: 16px;
    right: 0;
  }
  .sb-ig {
    background: radial-gradient(circle at 30% 110%, #fdd56a 0 18%, #f0573d 45%, #c83487 70%, #6a3dc4 100%);
  }
  .sb-tt {
    background: #111;
  }
  .sb-tt :global(svg) {
    filter: drop-shadow(-2px -1px 0 #25f4ee) drop-shadow(2px 1px 0 #fe2c55);
  }
  .sb-yt {
    background: #fff;
    color: #f00;
  }
  .sb-yt :global(svg) {
    width: 64%;
    height: 64%;
  }
  .sb-hashtags {
    margin: 0;
    text-align: center;
    font-family: var(--sb-hand);
    font-size: 1.6rem;
    line-height: 1.1;
    transform: rotate(-3deg);
  }

  /* Rules */
  .sb-rules {
    margin-top: 32px;
    padding-top: 22px;
