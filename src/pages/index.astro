---
import Layout from '~/layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import logo from '~/assets/images/shutterbuds/logo.png';
import keyArt from '~/assets/images/shutterbuds/keyart.jpg';
import photo1 from '~/assets/images/shutterbuds/photo1.jpg';
import photo2 from '~/assets/images/shutterbuds/photo2.jpg';
import photo3 from '~/assets/images/shutterbuds/photo3.jpg';

// Update this number to move the progress bar.
const SNAPS = 0;
const GOAL = 1000;
const pct = Math.min(100, Math.round((SNAPS / GOAL) * 100));

// Nav items are placeholders: they render but go nowhere.
const navItems = ['The Game', 'Photos', 'Community'];

const metadata = {
  title: 'Race to 1000',
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="sb">
    <!-- Header -->
    <header class="sb-header">
      <div class="sb-wrap sb-header-inner">
        <span class="sb-logo" aria-label="Shutterbuds">
          <Image src={logo} alt="Shutterbuds" width={400} class="sb-logo-img" loading="eager" />
        </span>
        <nav aria-label="Main">
          <ul class="sb-nav">
            {
              navItems.map((item) => (
                <li>
                  <button type="button" class="sb-nav-stub" aria-disabled="true">
                    {item}
                  </button>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <!-- Progress -->
    <section class="sb-progress" aria-label="Community goal progress">
      <div class="sb-wrap sb-progress-inner">
        <p class="sb-count">
          <span class="sb-count-num">{SNAPS.toLocaleString()}</span>
          <span class="sb-count-sep">/</span>
          <span>{GOAL.toLocaleString()}</span>
          <span class="sb-count-unit">photos</span>
        </p>
        <div
          class="sb-bar"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax={GOAL}
          aria-valuenow={SNAPS}
          aria-label="Photos posted"
        >
          <div class="sb-bar-fill" style={`width:${pct}%`}></div>
        </div>
      </div>
    </section>

    <!-- Hero -->
    <section class="sb-hero">
      <Image
        src={keyArt}
        alt="A Shutterbud holding a camera on a forest path"
        class="sb-hero-img"
        widths={[640, 960, 1232]}
        sizes="100vw"
        loading="eager"
      />
      <div class="sb-hero-shade"></div>
      <div class="sb-hero-copy">
        <h1 class="sb-hero-title">Race to 1000!</h1>
        <p class="sb-hero-sub">2 weeks · 1 goal · everybody wins</p>
      </div>
    </section>

    <!-- Campaign -->
    <main class="sb-wrap sb-campaign">
      <div class="sb-campaign-head">
        <h2 class="sb-h2">Giveaway Campaign</h2>
        <div class="sb-underline" aria-hidden="true"></div>
      </div>

      <div class="sb-grid">
        <!-- Unlock prize -->
        <aside class="sb-side sb-side-left">
          <Icon name="tabler:star-filled" class="sb-side-icon sb-star" />
          <div class="sb-mystery" aria-hidden="true">?</div>
          <p class="sb-tag">Unlocks at 1000</p>
          <h3 class="sb-side-title">Release</h3>
          <p class="sb-side-sub">a new creature</p>
        </aside>

        <!-- Main card -->
        <article class="sb-card">
          <div class="sb-card-text">
            <h3 class="sb-card-title">Snap. Post. Unlock.</h3>
            <p>
              For two weeks, take photos in Shutterbuds and post them with <strong>#Shutterbuds</strong>. Every photo
              counts toward one shared goal.
            </p>
            <ol class="sb-steps">
              <li>Snap a photo in-game.</li>
              <li>Post it with <strong>#Shutterbuds</strong> and <strong>#RaceTo1000</strong>.</li>
              <li>Help the community hit 1000 photos in 2 weeks.</li>
              <li>Hit the goal and the prize unlocks for everyone who entered.</li>
            </ol>
            <p class="sb-card-note">Bring your buds. Every friend who posts gets us all closer.</p>
          </div>

          <div class="sb-card-media">
            <div class="sb-circles">
              <Image src={photo1} alt="In-game photo" width={360} class="sb-circle sb-c1" />
              <Image src={photo2} alt="In-game photo" width={360} class="sb-circle sb-c2" />
              <Image src={photo3} alt="In-game photo" width={360} class="sb-circle sb-c3" />
            </div>
            <p class="sb-hashtags">#RaceTo1000<br />#Shutterbuds</p>
          </div>
        </article>

        <!-- Team prize -->
        <aside class="sb-side sb-side-right">
          <Icon name="tabler:crown" class="sb-side-icon sb-crown" />
          <div class="sb-ticket" aria-hidden="true">
            <Icon name="tabler:ticket" />
          </div>
          <p class="sb-tag">Bonus</p>
          <h3 class="sb-side-title">#1 Team</h3>
          <p class="sb-side-sub">gets a special prize</p>
        </aside>
      </div>
    </main>

    <footer class="sb-footer">
      <div class="sb-wrap">
        <p>© {new Date().getFullYear()} Shutterbuds</p>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .sb {
    --sb-cream: #f6eedd;
    --sb-paper: #fffaf0;
    --sb-brown: #5b3a22;
    --sb-brown-soft: #8a6446;
    --sb-forest: #2e5e2a;
    --sb-leaf: #5fae38;
    --sb-lime: #c9e04b;
    --sb-red: #d8442f;
    --sb-sky: #3bb0e3;
    --sb-display: 'Fredoka', 'Nunito', system-ui, sans-serif;
    --sb-body: 'Nunito', system-ui, sans-serif;

    background: var(--sb-cream);
    color: var(--sb-brown);
    font-family: var(--sb-body);
    letter-spacing: normal;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .sb-wrap {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Header */
  .sb-header {
    background: var(--sb-paper);
    border-bottom: 3px solid var(--sb-brown);
  }
  .sb-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
  }
  .sb-logo-img {
    height: 52px;
    width: auto;
  }
  .sb-nav {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sb-nav-stub {
    font-family: var(--sb-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--sb-brown);
    background: none;
    border: 0;
    padding: 8px 12px;
    border-radius: 999px;
    cursor: default;
  }
  .sb-nav-stub:hover {
    background: var(--sb-cream);
  }

  /* Progress */
  .sb-progress {
    background: var(--sb-paper);
    border-bottom: 3px solid var(--sb-brown);
  }
  .sb-progress-inner {
    padding-top: 10px;
    padding-bottom: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .sb-count {
    margin: 0;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .sb-count-num {
    color: var(--sb-leaf);
  }
  .sb-count-sep {
    color: var(--sb-brown-soft);
  }
  .sb-count-unit {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sb-brown-soft);
  }
  .sb-bar {
    width: min(100%, 720px);
    height: 22px;
    background-color: var(--sb-cream);
    background-image: radial-gradient(var(--sb-brown-soft) 1px, transparent 1.5px);
    background-size: 18px 100%;
    border: 3px solid var(--sb-brown);
    border-radius: 999px;
    overflow: hidden;
    box-shadow: 0 3px 0 var(--sb-brown);
  }
  .sb-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--sb-leaf), var(--sb-lime));
    border-radius: 999px;
  }

  /* Hero */
  .sb-hero {
    position: relative;
    height: clamp(280px, 52vw, 560px);
    overflow: hidden;
    border-bottom: 3px solid var(--sb-brown);
  }
  .sb-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .sb-hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(20, 35, 15, 0) 45%, rgba(20, 35, 15, 0.65) 100%);
  }
  .sb-hero-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(16px, 4vw, 40px);
    text-align: center;
    padding: 0 16px;
  }
  .sb-hero-title {
    margin: 0;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    line-height: 1;
    color: var(--sb-cream);
    -webkit-text-stroke: 3px var(--sb-brown);
    paint-order: stroke fill;
    text-shadow: 0 5px 0 var(--sb-brown);
  }
  .sb-hero-sub {
    margin: 12px 0 0;
    font-family: var(--sb-display);
    font-weight: 600;
    font-size: clamp(1rem, 2.4vw, 1.4rem);
    color: #fff;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  }

  /* Campaign */
  .sb-campaign {
    padding-top: 40px;
    padding-bottom: 56px;
    flex: 1;
  }
  .sb-campaign-head {
    text-align: center;
    margin-bottom: 28px;
  }
  .sb-h2 {
    margin: 0;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--sb-forest);
  }
  .sb-underline {
    width: min(100%, 420px);
    height: 12px;
    margin: 6px auto 0;
    border: 3px solid var(--sb-brown);
    border-radius: 999px;
    background: var(--sb-lime);
  }
  .sb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .sb-grid {
      grid-template-columns: 1fr 2.2fr 1fr;
    }
  }

  /* Sides */
  .sb-side {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
  }
  .sb-side-icon {
    width: 44px;
    height: 44px;
    margin-bottom: 12px;
  }
  .sb-star {
    color: #f2b632;
  }
  .sb-crown {
    color: #e0a526;
  }
  .sb-mystery,
  .sb-ticket {
    width: 150px;
    height: 150px;
    border: 4px solid var(--sb-brown);
    border-radius: 24px;
    box-shadow: 0 6px 0 var(--sb-brown);
    display: grid;
    place-items: center;
  }
  .sb-mystery {
    background: repeating-linear-gradient(45deg, #6b4a2f 0 14px, #7a5638 14px 28px);
    color: var(--sb-cream);
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: 6rem;
    line-height: 1;
    -webkit-text-stroke: 3px var(--sb-brown);
    paint-order: stroke fill;
  }
  .sb-ticket {
    background: var(--sb-leaf);
    color: var(--sb-paper);
    font-size: 5.5rem;
    transform: rotate(-8deg);
  }
  .sb-tag {
    margin: 22px 0 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sb-brown-soft);
  }
  .sb-side-title {
    margin: 4px 0 0;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--sb-brown);
  }
  .sb-side-sub {
    margin: 4px 0 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  /* Main card */
  .sb-card {
    background: var(--sb-paper);
    border: 4px solid var(--sb-brown);
    border-radius: 20px;
    box-shadow: 0 8px 0 var(--sb-brown);
    padding: 28px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .sb-card {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  @media (max-width: 899px) {
    .sb-card {
      order: -1;
    }
  }
  .sb-card-title {
    margin: 0 0 12px;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: 1.45rem;
    line-height: 1.2;
    color: var(--sb-forest);
  }
  .sb-card-text p {
    margin: 0 0 12px;
    line-height: 1.55;
  }
  .sb-steps {
    margin: 0 0 14px;
    padding-left: 1.3em;
    list-style: decimal;
    line-height: 1.55;
  }
  .sb-steps li {
    margin-bottom: 6px;
  }
  .sb-steps li::marker {
    font-family: var(--sb-display);
    font-weight: 700;
    color: var(--sb-leaf);
  }
  .sb-card-note {
    font-weight: 700;
    color: var(--sb-forest);
  }
  .sb-card-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .sb-circles {
    position: relative;
    width: 230px;
    height: 220px;
  }
  .sb-circle {
    position: absolute;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--sb-brown);
    background: var(--sb-cream);
  }
  .sb-c1 {
    width: 100px;
    height: 100px;
    top: 0;
    right: 30px;
  }
  .sb-c2 {
    width: 120px;
    height: 120px;
    bottom: 0;
    left: 0;
  }
  .sb-c3 {
    width: 96px;
    height: 96px;
    bottom: 12px;
    right: 0;
  }
  .sb-hashtags {
    margin: 0;
    text-align: center;
    font-family: var(--sb-display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--sb-leaf);
  }

  /* Footer */
  .sb-footer {
    background: var(--sb-forest);
    color: var(--sb-cream);
    text-align: center;
    padding: 18px 0;
    font-size: 0.9rem;
  }
  .sb-footer p {
    margin: 0;
  }

  @media (max-width: 520px) {
    .sb-nav-stub {
      padding: 6px 8px;
      font-size: 0.85rem;
    }
    .sb-logo-img {
      height: 38px;
    }
  }
</style>
